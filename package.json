{
  "name": "lumen-wrt",
  "version": "0.20.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Lumen: a modern admin panel for OpenWrt",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build:demo": "VITE_MOCK=1 vite build --outDir ${DEMO_OUT:-../lumen/demo} --emptyOutDir",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "deploy": "bash scripts/deploy.sh",
    "release": "node scripts/release.mjs",
    "release:patch": "npm version patch --no-git-tag-version && npm run release",
    "release:minor": "npm version minor --no-git-tag-version && npm run release"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.9",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
