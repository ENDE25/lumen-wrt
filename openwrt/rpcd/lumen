// Lumen rpcd plugin (ucode). Installed to /usr/share/rpcd/ucode/lumen
// Gathers what the stock ubus objects do not expose: which bridge port each client sits behind.
// NOTE: never call rpcd's own ubus objects (iwinfo, file, ...) from here: rpcd is single
// threaded and would deadlock on itself. Wifi data is fetched by the frontend instead.
'use strict';

import { readfile, writefile, lsdir, stat, lstat, popen, access, mkdir, unlink, chmod, rename } from 'fs';
import { cursor } from 'uci';

const HISTORY_FILE = '/tmp/lumen/history.json';
const CLIENTS_FILE = '/tmp/lumen/clients.json';
const CL_RANGES = { '24h': 86400, '7d': 7 * 86400, '30d': 30 * 86400 };
const RANGES = { '1h': 3600, '24h': 86400, '7d': 7 * 86400, '30d': 30 * 86400, '90d': 90 * 86400 };

function mac_from(s, o) {
	return sprintf('%02x:%02x:%02x:%02x:%02x:%02x',
		ord(s, o), ord(s, o + 1), ord(s, o + 2), ord(s, o + 3), ord(s, o + 4), ord(s, o + 5));
}

function trim(s) {
	return replace(s ?? '', /[\s\n]+$/, '');
}

// IPv4 neighbours straight from the kernel: ip, mac, device.
function read_arp() {
	let out = [], txt = readfile('/proc/net/arp');
	if (!txt) return out;
	let first = true;
	for (let line in split(txt, '\n')) {
		if (first) { first = false; continue; }
		let f = split(trim(line), /\s+/);
		if (length(f) < 6) continue;
		// flags 0x2 = complete entry
		if (f[2] == '0x0') continue;
		push(out, { ip: f[0], mac: f[3], dev: f[5] });
	}
	return out;
}

// Kernel routing tables as raw hex (the browser formats them): IPv4 from /proc/net/route, IPv6 from /proc/net/ipv6_route.
function read_routes() {
	let v4 = [], v6 = [], first = true;
	for (let line in split(readfile('/proc/net/route') ?? '', '\n')) {
		if (first) { first = false; continue; }
		let f = split(trim(line), /\s+/);
		if (length(f) < 8) continue;
		push(v4, { dev: f[0], dst: f[1], gw: f[2], flags: hex(f[3]), metric: int(f[6]), mask: f[7] });
	}
	for (let line in split(readfile('/proc/net/ipv6_route') ?? '', '\n')) {
		let f = split(trim(line), /\s+/);
		if (length(f) < 10) continue;
		push(v6, { dst: f[0], plen: hex(f[1]), gw: f[4], metric: hex(f[5]), flags: hex(f[8]), dev: f[9] });
	}
	return { v4, v6 };
}

function read_bridges() {
	let out = {};
	for (let name in lsdir('/sys/class/net') ?? []) {
		let members = lsdir(`/sys/class/net/${name}/brif`);
		if (members) out[name] = sort(members);
	}
	return out;
}

// Parse /sys/class/net/<br>/brforward (array of 16-byte struct fdb_entry).
function read_fdb(br) {
	let raw = readfile(`/sys/class/net/${br}/brforward`);
	if (!raw) return [];
	let ports = {};
	for (let dev in lsdir(`/sys/class/net/${br}/brif`) ?? []) {
		let n = trim(readfile(`/sys/class/net/${br}/brif/${dev}/port_no`));
		if (n != '') ports[hex(n)] = dev;
	}
	let out = [];
	for (let o = 0; o + 16 <= length(raw); o += 16) {
		let port = ord(raw, o + 6) | (ord(raw, o + 12) << 8);
		push(out, { mac: mac_from(raw, o), port: ports[port], local: ord(raw, o + 7) != 0 });
	}
	return out;
}

// ---- host stats. /proc is virtualised (lxcfs) inside containers, unlike the sysinfo() syscall
// behind `ubus call system info`, which reports the *host* in LXC. So read /proc directly.
function int_file(path) {
	let t = trim(readfile(path));
	return t == '' ? null : int(t);
}

const KEEP = { MemTotal: 1, MemFree: 1, MemAvailable: 1, Buffers: 1, Cached: 1, SReclaimable: 1, Shmem: 1, SwapTotal: 1, SwapFree: 1 };

function read_meminfo() {
	let out = {};
	for (let line in split(readfile('/proc/meminfo') ?? '', '\n')) {
		let m = match(line, /^([A-Za-z_()0-9]+):\s+([0-9]+)/);
		if (m && m[1] in KEEP) out[m[1]] = int(m[2]) * 1024;
	}
	return out;
}

function read_cpu() {
	let cores = [], total = null;
	for (let line in split(readfile('/proc/stat') ?? '', '\n')) {
		let m = match(line, /^cpu([0-9]*)\s+(.*)$/);
		if (!m) continue;
		let f = map(split(trim(m[2]), /\s+/), (x) => int(x));
		let sum = 0;
		for (let i = 0; i < 8 && i < length(f); i++) sum += f[i];
		let e = { busy: sum - f[3] - (f[4] ?? 0), total: sum };
		if (m[1] == '') total = e; else push(cores, e);
	}
	let model = null, count = 0;
	for (let line in split(readfile('/proc/cpuinfo') ?? '', '\n')) {
		if (match(line, /^processor\s*:/)) count++;
		let m = match(line, /^(model name|Hardware|system type|cpu model)\s*:\s*(.+)$/);
		if (m && !model) model = trim(m[2]);
	}
	return { total, cores, model, count };
}

function read_temps() {
	let out = [];
	for (let z in lsdir('/sys/class/thermal') ?? []) {
		if (!match(z, /^thermal_zone/)) continue;
		let t = int_file(`/sys/class/thermal/${z}/temp`);
		if (t != null) push(out, { label: trim(readfile(`/sys/class/thermal/${z}/type`)) || z, c: t / 1000 });
	}
	for (let h in lsdir('/sys/class/hwmon') ?? []) {
		let base = `/sys/class/hwmon/${h}`, name = trim(readfile(`${base}/name`)) || h;
		for (let f in lsdir(base) ?? []) {
			let m = match(f, /^temp([0-9]+)_input$/);
			if (!m) continue;
			let t = int_file(`${base}/${f}`);
			let lbl = trim(readfile(`${base}/temp${m[1]}_label`));
			if (t != null) push(out, { label: lbl != '' ? `${name} ${lbl}` : name, c: t / 1000 });
		}
	}
	return out;
}

// Traffic history written by the lumen-history collector. Only the requested window is returned.
function history(range) {
	let span = RANGES[range] ?? 86400;
	let raw = readfile(HISTORY_FILE);
	if (!raw) return { running: false };
	let d = json(raw);
	if (!d?.fine) return { running: false };
	let fine = span <= 7 * 86400;
	let tier = fine ? d.fine : d.hour, step = fine ? d.step : 3600;
	let now = time(), cutoff = now - span - step;
	let from = 0;
	while (from < length(tier.t) && tier.t[from] < cutoff) from++;
	let out = { running: now - d.lastT < 3 * d.step + 5, step, tier: fine ? 'fine' : 'hour', now, since: length(tier.t) ? tier.t[0] : null, t: slice(tier.t, from), rx: {}, tx: {} };
	for (let dev in keys(tier.rx)) { out.rx[dev] = slice(tier.rx[dev], from); out.tx[dev] = slice(tier.tx[dev], from); }
	return out;
}


// ---- per-client traffic (hourly buckets written by the collector)
function clients_file() {
	let raw = readfile(CLIENTS_FILE);
	if (!raw) return null;
	let d = json(raw);
	return d?.hour ? d : null;
}

function collector_cfg() {
	let c = cursor();
	return {
		interval: int(c.get('lumen', 'history', 'interval') ?? 300),
		enabled: (c.get('lumen', 'history', 'clients') ?? '1') != '0',
		// with flow offloading, established flows bypass the forward hook, so counters under-report
		offload: (c.get('firewall', '@defaults[0]', 'flow_offloading') ?? '0') == '1' || (c.get('firewall', '@defaults[0]', 'flow_offloading_hw') ?? '0') == '1',
		// history is only kept across reboots when the collector mirrors it to a file
		persist: (c.get('lumen', 'history', 'persist') ?? '') != '',
	};
}

function clients(range) {
	let span = CL_RANGES[range] ?? 86400, cfg = collector_cfg();
	let d = clients_file();
	let out = { enabled: cfg.enabled, offload: cfg.offload, persist: cfg.persist, running: false };
	if (!d) return out;
	let now = time(), st = stat(CLIENTS_FILE);
	out.running = now - (st?.mtime ?? 0) < 3 * cfg.interval + 30;
	out.now = now;
	out.since = length(d.hour.t) ? d.hour.t[0] : null;
	out.totals = {};
	let from = 0;
	while (from < length(d.hour.t) && d.hour.t[from] + 3600 <= now - span) from++;
	for (let mac in keys(d.hour.d)) {
		let rx = 0, tx = 0;
		for (let i = from; i < length(d.hour.t); i++) { rx += d.hour.d[mac].rx[i]; tx += d.hour.d[mac].tx[i]; }
		if (rx || tx) out.totals[mac] = [rx, tx];
	}
	// when each device last had traffic (end of its latest active hour, never in the future), and who it was
	out.last = {};
	for (let mac in keys(d.hour.d)) {
		let b = d.hour.d[mac];
		for (let i = length(d.hour.t) - 1; i >= 0; i--) {
			if (!b.rx[i] && !b.tx[i]) continue;
			out.last[mac] = d.hour.t[i] + 3600 > now ? now : d.hour.t[i] + 3600;
			break;
		}
	}
	out.meta = d.meta ?? {};
	return out;
}

function client_series(mac, range) {
	let span = CL_RANGES[range] ?? 86400;
	let d = clients_file();
	if (!d || !(mac in d.hour.d)) return { t: [], rx: [], tx: [] };
	let now = time(), from = 0;
	while (from < length(d.hour.t) && d.hour.t[from] + 3600 <= now - span) from++;
	return { now, step: 3600, t: slice(d.hour.t, from), rx: slice(d.hour.d[mac].rx, from), tx: slice(d.hour.d[mac].tx, from) };
}

// ---- package management (apk). Short queries run inline; install/remove/upgrade/update run as a detached job
// (openwrt/bin/lumen-pkg-job.sh) so they survive an rpcd restart and can be followed through pkg_status.
const PKG_DIR = '/tmp/lumen/pkg';
const PKG_NAME = /^[A-Za-z0-9][A-Za-z0-9._+-]*$/;
// Removing these would brick the router or the panel itself.
const PKG_CORE = /^(base-files|busybox|libc|libgcc1?|apk-.*|procd.*|ubus.*|ubox|libubox.*|libubus.*|libblobmsg.*|libjson-script.*|jshn|netifd|uhttpd.*|rpcd.*|dropbear|fstools|kernel|mtd|openwrt-keyring|uci|libuci.*|logd|firewall4|ucode.*|libucode.*)$/;

function apk_query(args) {
	let p = popen('apk query --format json ' + args + ' 2>/dev/null', 'r');
	if (!p) return [];
	let txt = p.read('all');
	p.close();
	if (!txt || txt == '') return [];
	return json(txt) ?? [];
}

function run_text(cmd) {
	let p = popen(cmd + ' 2>&1', 'r');
	if (!p) return '';
	let t = p.read('all');
	p.close();
	return t ?? '';
}

function split_pkgs(str) {
	let out = [];
	for (let n in split(trim(str ?? ''), /\s+/)) if (n != '') push(out, n);
	return out;
}

function valid_pkgs(list) {
	for (let n in list) if (!match(n, PKG_NAME)) return false;
	return true;
}

function pkg_installed() {
	let out = [];
	for (let x in apk_query("--fields name,version,description,installed-size,origin --installed --from system '*'"))
		push(out, { name: x.name, version: x.version, description: x.description, size: x['installed-size'], origin: x.origin, core: !!match(x.name, PKG_CORE) });
	return sort(out, (a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0);
}

function pkg_upgradable() {
	let inst = {};
	for (let x in apk_query("--fields name,version --installed --from system '*'")) inst[x.name] = x.version;
	let out = [];
	for (let x in apk_query("--fields name,version --upgradable '*'"))
		push(out, { name: x.name, from: inst[x.name], to: x.version });
	return out;
}

function pkg_search(q) {
	if (!match(q ?? '', /^[A-Za-z0-9._+-]{2,40}$/)) return { error: 'Use at least 2 letters, digits or . _ + -' };
	let all = apk_query(`--fields name,version,description,installed-size --available '*${q}*'`);
	let rank = (n) => n == q ? 0 : index(n, q) == 0 ? 1 : 2;
	let res = sort(all, (a, b) => rank(a.name) - rank(b.name) || length(a.name) - length(b.name) || (a.name < b.name ? -1 : 1));
	let out = [];
	for (let x in slice(res, 0, 100)) push(out, { name: x.name, version: x.version, description: x.description, size: x['installed-size'] });
	return { results: out, total: length(all) };
}

/** What apk would do, without doing it. */
function pkg_plan(action, pkgsStr) {
	if (!(action in ['add', 'del', 'upgrade'])) return { error: 'unsupported action' };
	let pk = split_pkgs(pkgsStr);
	if (!valid_pkgs(pk) || (action != 'upgrade' && !length(pk))) return { error: 'invalid package name' };
	if (action == 'del') for (let n in pk) if (match(n, PKG_CORE)) return { error: `${n} is a core system package and cannot be removed here` };
	return { text: trim(run_text(`apk ${action} --simulate ${join(' ', pk)}`)) };
}

function pkg_status() {
	let rd = (f) => trim(readfile(`${PKG_DIR}/${f}`) ?? '');
	let state = rd('state');
	if (state == '') return { state: 'idle' };
	let log = readfile(`${PKG_DIR}/log`) ?? '';
	if (length(log) > 20000) log = '…' + substr(log, length(log) - 20000);
	return { state, cmd: rd('cmd'), code: rd('code') == '' ? null : int(rd('code')), started: int(rd('started') || 0), ended: int(rd('ended') || 0), log };
}

function pkg_run(action, pkgsStr) {
	if (!(action in ['update', 'upgrade', 'add', 'del'])) return { error: 'unsupported action' };
	let pk = split_pkgs(pkgsStr);
	if (!valid_pkgs(pk) || ((action == 'add' || action == 'del') && !length(pk))) return { error: 'invalid package name' };
	if (action == 'del') for (let n in pk) if (match(n, PKG_CORE)) return { error: `${n} is a core system package and cannot be removed here` };
	let st = pkg_status();
	// a job left "running" for over 30 minutes is treated as dead
	if (st.state == 'running' && time() - st.started < 1800) return { error: 'another package operation is still running' };
	system(`setsid sh /usr/libexec/lumen/pkg-job.sh ${action} ${join(' ', pk)} </dev/null >/dev/null 2>&1 &`);
	return { started: true };
}

// ---- Lumen's own lifecycle (installed by openwrt/bin/lumen-manage.sh): version, update, uninstall.
// update/uninstall run as a detached job so they survive the rpcd restart they cause.
const SELF_DIR = '/tmp/lumen-self';
const MANAGER = '/usr/libexec/lumen/manage.sh';

function lumen_version() {
	let raw = readfile('/usr/share/lumen/version.json');
	let d = raw ? json(raw) : null;
	let url = cursor().get('lumen', 'update', 'url');
	return { managed: !!d?.version && access(MANAGER), version: d?.version, installed: d?.installed, base: (url && url != '') ? url : d?.base };
}

function self_status() {
	let rd = (f) => trim(readfile(`${SELF_DIR}/${f}`) ?? '');
	let state = rd('state');
	if (state == '') return { state: 'idle' };
	let log = readfile(`${SELF_DIR}/log`) ?? '';
	if (length(log) > 20000) log = '…' + substr(log, length(log) - 20000);
	return { state, cmd: rd('cmd'), code: rd('code') == '' ? null : int(rd('code')), started: int(rd('started') || 0), ended: int(rd('ended') || 0), log };
}

// Empty the system log. logd keeps it in RAM; kernel lines (where firewall drops are written) are re-read from the
// kernel ring buffer when logd restarts, so that one is cleared first. Runs detached so rpcd is not held up.
function log_clear() {
	system('(dmesg -c >/dev/null 2>&1; /etc/init.d/log restart) >/dev/null 2>&1 &');
	return { ok: true };
}

function self_run(action, purge) {
	if (!(action in ['update', 'uninstall'])) return { error: 'unsupported action' };
	if (!access(MANAGER)) return { error: 'Lumen was not installed with the installer, so it cannot manage itself' };
	let st = self_status();
	if (st.state == 'running' && time() - st.started < 1800) return { error: 'another operation is still running' };
	let extra = (action == 'uninstall' && purge == '1') ? ' --purge' : '';
	system(`setsid sh ${MANAGER} job ${action}${extra} </dev/null >/dev/null 2>&1 &`);
	return { started: true };
}

// ---- Add-on apps: the LuCI apps installed on the router (luci-app-*). Each package drops a menu
// description in /usr/share/luci/menu.d; read those the way LuCI does so Lumen can list and open them.
const LUCI_MENU = '/usr/share/luci/menu.d';
// LuCI itself, and apps whose job Lumen already does on its own pages.
const APP_SKIP = /^luci-(base|mod-.*|app-(firewall|package-manager|lumen))\.json$/;
// Apps whose daemon is not named after the app.
const APP_DAEMON = { upnp: 'miniupnpd', statistics: 'collectd', wol: '', ttyd: 'ttyd' };

function menu_dep_ok(dep) {
	for (let cfg in keys(dep?.uci ?? {})) if (!access(`/etc/config/${cfg}`)) return false;
	for (let path, kind in dep?.fs ?? {}) {
		let st = stat(path);
		if (!st) return false;
		if (kind == 'directory' && st.type != 'directory') return false;
		if (kind == 'executable' && !access(path, 'x')) return false;
	}
	return true;
}

function app_daemon(id, pkg, dep) {
	if (id in APP_DAEMON) return APP_DAEMON[id];
	let short = replace(pkg, /^luci-app-/, '');
	for (let c in [id, short, ...keys(dep?.uci ?? {})]) if (access(`/etc/init.d/${c}`)) return c;
	return '';
}

function read_apps() {
	let pkgs = {};
	for (let x in apk_query("--fields name,version,description --installed --from system 'luci-app-*'")) pkgs[x.name] = x;
	let out = [], seen = {};
	for (let f in sort(lsdir(LUCI_MENU) ?? [])) {
		if (!match(f, /\.json$/) || match(f, APP_SKIP)) continue;
		let menu;
		try { menu = json(readfile(`${LUCI_MENU}/${f}`) ?? 'null'); } catch (e) { continue; }
		if (type(menu) != 'object') continue;
		let pkg = replace(f, /\.json$/, '');
		for (let path in keys(menu)) {
			// a top entry is one whose parent is not described in the same file
			let parent = replace(path, /\/[^\/]+$/, '');
			if (parent in menu) continue;
			let node = menu[path];
			if (!node?.title || !menu_dep_ok(node.depends)) continue;
			let tabs = [];
			for (let p in keys(menu))
				if (index(p, path + '/') == 0 && !match(substr(p, length(path) + 1), /\//) && menu[p]?.title)
					push(tabs, { path: p, title: menu[p].title, order: menu[p].order ?? 999 });
			tabs = sort(tabs, (a, b) => a.order - b.order);
			let id = replace(path, /^.*\//, '');
			if (seen[id]) id = `${id}-${seen[id]}`;
			seen[id] = (seen[id] ?? 0) + 1;
			let info = pkgs[pkg] ?? {};
			push(out, {
				id, pkg, title: node.title, path, section: split(path, '/')[1] ?? '',
				tabs: map(tabs, (t) => ({ path: t.path, title: t.title })),
				version: info.version, description: info.description,
				service: app_daemon(id, pkg, node.depends)
			});
		}
	}
	return sort(out, (a, b) => a.title < b.title ? -1 : a.title > b.title ? 1 : 0);
}

// ---- Web terminal (ttyd). Optional: only installed when the user asks for it on the Terminal page.
// Its config is read and written here because without luci-app-ttyd the session has no uci ACL for it.
// Lumen sets it up one of three ways, picked by the page:
//   proxy: behind nginx at /lumen-terminal/, ttyd on a UNIX socket only (no TCP port at all)
//   ssl:   ttyd on the LAN port with SSL, using uhttpd's certificate (panel opened over HTTPS)
//   plain: ttyd on the LAN port over HTTP (panel opened over HTTP)
// In every mode ttyd runs term-login.sh: a one-time ticket from this plugin opens a shell without a
// second password prompt, anything else gets the normal login.
const TERM_LOGIN = '/usr/libexec/lumen/term-login.sh';
const TERM_SOCK = '/var/run/lumen-ttyd.sock';
const TERM_NGINX = '/etc/nginx/conf.d/lumen-terminal.locations';
const TERM_TICKETS = '/tmp/lumen/term';
const TERM_PEM = '/etc/lumen/ttyd';   // .crt / .key: uhttpd's certificate in the PEM form ttyd needs
const NGINX_LOCATION = `# Lumen web terminal: ttyd behind this server, listening on a UNIX socket only. Managed by Lumen
# (Terminal page); removed when the terminal or Lumen is removed.
location /lumen-terminal/ {
	proxy_pass http://unix:${TERM_SOCK}:/;
	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection "upgrade";
	proxy_read_timeout 1d;
	proxy_buffering off;
}
`;

function web_server() {
	if (system('/etc/init.d/nginx enabled >/dev/null 2>&1') == 0 && access('/etc/nginx/conf.d')) return 'nginx';
	return 'uhttpd';
}

// uhttpd's certificate and key are usually DER (px5g); ttyd only reads PEM. PEM input is copied as is.
function pem(der, label) {
	let b = b64enc(der), out = `-----BEGIN ${label}-----\n`;
	for (let i = 0; i < length(b); i += 64) out += substr(b, i, 64) + '\n';
	return out + `-----END ${label}-----\n`;
}
function key_label(der) {
	// SEQUENCE { INTEGER version, ... }: SEC1 EC (version 1, then OCTET STRING), PKCS#1 RSA (0, INTEGER), PKCS#8 (0, SEQUENCE)
	let i = ord(der, 1) & 0x80 ? 2 + (ord(der, 1) & 0x7f) : 2;
	let ver = ord(der, i + 2), next = ord(der, i + 3);
	return (ver == 1 && next == 0x04) ? 'EC PRIVATE KEY' : (ver == 0 && next == 0x02) ? 'RSA PRIVATE KEY' : 'PRIVATE KEY';
}
function term_pem(cert, key) {
	let c = readfile(cert), k = readfile(key);
	if (!c || !k) return null;
	mkdir('/etc/lumen', 0o755);
	let pc = index(c, '-----BEGIN') == 0 ? c : pem(c, 'CERTIFICATE');
	let pk = index(k, '-----BEGIN') == 0 ? k : pem(k, key_label(k));
	writefile(TERM_PEM + '.crt', pc);
	writefile(TERM_PEM + '.key.new', pk); chmod(TERM_PEM + '.key.new', 0o600); rename(TERM_PEM + '.key.new', TERM_PEM + '.key');
	return [TERM_PEM + '.crt', TERM_PEM + '.key'];
}

function ttyd_section(c) {
	let name = null;
	c.foreach('ttyd', 'ttyd', (s) => { if (!name) name = s['.name']; });
	return name;
}

function terminal_info() {
	if (!access('/usr/bin/ttyd', 'x')) return { installed: false, server: web_server() };
	let c = cursor(), sid = ttyd_section(c), sec = sid ? c.get_all('ttyd', sid) : null;
	let ours = sec?.command == TERM_LOGIN && sec?.url_arg == '1';
	let mode = !ours ? 'custom'
		: (sec.interface == TERM_SOCK && access(TERM_NGINX)) ? 'proxy'
		: sec.ssl == '1' ? (sec.ssl_cert == TERM_PEM + '.crt' && access(TERM_PEM + '.crt') ? 'ssl' : 'custom') : 'plain';
	return {
		installed: true, configured: !!sec, mode, server: web_server(),
		port: sec?.port ?? '7681', ssl: sec?.ssl == '1', url_override: sec?.url_override ?? '',
		interface: sec?.interface ?? '', luci_app: !!access('/usr/share/luci/menu.d/luci-app-ttyd.json'),
		running: system('/etc/init.d/ttyd running >/dev/null 2>&1') == 0
	};
}

function nginx_reload() {
	system('(sleep 1; /etc/init.d/nginx reload) >/dev/null 2>&1 &');
}

function terminal_setup(mode) {
	if (!(mode in ['proxy', 'ssl', 'plain', 'none'])) return { error: 'unsupported mode' };
	let had_nginx = !!access(TERM_NGINX);
	if (mode != 'proxy' && had_nginx) { unlink(TERM_NGINX); nginx_reload(); }
	if (!access('/usr/bin/ttyd', 'x')) return mode == 'none' ? { ok: true } : { error: 'the terminal (ttyd) is not installed' };
	if (!access(TERM_LOGIN, 'x')) return { error: 'this Lumen installation is missing ' + TERM_LOGIN };

	let c = cursor(), sid = ttyd_section(c);
	if (mode == 'none') {
		// leave a stock ttyd behind: the normal login, and never a port Lumen had kept closed
		if (sid && c.get('ttyd', sid, 'command') == TERM_LOGIN) {
			c.set('ttyd', sid, 'command', '/bin/login');
			c.delete('ttyd', sid, 'url_arg');
			if (c.get('ttyd', sid, 'interface') == TERM_SOCK) c.set('ttyd', sid, 'enable', '0');
			c.commit('ttyd');
			system('/etc/init.d/ttyd restart >/dev/null 2>&1');
		}
		unlink(TERM_PEM + '.crt'); unlink(TERM_PEM + '.key');
		return { ok: true };
	}

	if (mode == 'proxy' && web_server() != 'nginx') return { error: 'this router does not use nginx' };
	if (mode == 'ssl') {
		let cert = c.get('uhttpd', 'main', 'cert') ?? '/etc/uhttpd.crt', key = c.get('uhttpd', 'main', 'key') ?? '/etc/uhttpd.key';
		if (!access(cert) || !access(key)) return { error: 'the router has no HTTPS certificate yet (enable HTTPS for the panel first)' };
		let files = term_pem(cert, key);
		if (!files) return { error: 'could not read the router certificate' };
		c.set('ttyd', sid ?? (sid = c.add('ttyd', 'ttyd')), 'ssl', '1');
		c.set('ttyd', sid, 'ssl_cert', files[0]);
		c.set('ttyd', sid, 'ssl_key', files[1]);
	}
	sid = sid ?? c.add('ttyd', 'ttyd');
	c.set('ttyd', sid, 'enable', '1');
	c.set('ttyd', sid, 'command', TERM_LOGIN);
	c.set('ttyd', sid, 'url_arg', '1');
	// refuse websockets opened by other sites. Not in ssl mode: there ttyd speaks HTTP/2, has no Host header to
	// compare and refuses every connection. The one-time ticket is what grants a shell in every mode anyway.
	if (mode == 'ssl') c.delete('ttyd', sid, 'check_origin'); else c.set('ttyd', sid, 'check_origin', '1');
	if (mode != 'ssl') {
		c.delete('ttyd', sid, 'ssl'); c.delete('ttyd', sid, 'ssl_cert'); c.delete('ttyd', sid, 'ssl_key');
		unlink(TERM_PEM + '.crt'); unlink(TERM_PEM + '.key');
	}
	c.set('ttyd', sid, 'interface', mode == 'proxy' ? TERM_SOCK : '@lan');
	c.commit('ttyd');

	if (mode == 'proxy' && readfile(TERM_NGINX) != NGINX_LOCATION) {
		writefile(TERM_NGINX + '.new', NGINX_LOCATION);
		rename(TERM_NGINX + '.new', TERM_NGINX);
		nginx_reload();
	}
	system('/etc/init.d/ttyd enable >/dev/null 2>&1; /etc/init.d/ttyd restart >/dev/null 2>&1');
	return { ok: true, mode };
}

// A one-time ticket that lets the panel open the terminal without a second password prompt.
function terminal_ticket() {
	mkdir('/tmp/lumen', 0o755);
	mkdir(TERM_TICKETS, 0o700);
	let st = lstat(TERM_TICKETS);
	if (st?.type != 'directory' || st?.uid != 0) return { error: 'unsafe ticket directory' };
	chmod(TERM_TICKETS, 0o700);
	let now = time();
	for (let f in lsdir(TERM_TICKETS) ?? []) {
		let fs = lstat(`${TERM_TICKETS}/${f}`);
		if (!fs || now - fs.mtime > 60) unlink(`${TERM_TICKETS}/${f}`);
	}
	let raw = readfile('/dev/urandom', 16);
	if (length(raw) != 16) return { error: 'no randomness available' };
	let t = '';
	for (let i = 0; i < 16; i++) t += sprintf('%02x', ord(raw, i));
	writefile(`${TERM_TICKETS}/${t}`, '');
	return { ticket: t, expires: 60 };
}

const methods = {
	terminal: { call: function(request) { return terminal_info(); } },
	terminal_setup: { args: { mode: 'mode' }, call: function(request) { return terminal_setup(request.args?.mode); } },
	terminal_ticket: { call: function(request) { return terminal_ticket(); } },
	apps: { call: function(request) { return { apps: read_apps(), luci: !!access('/www/cgi-bin/luci') }; } },
	version: { call: function(request) { return lumen_version(); } },
	self_status: { call: function(request) { return self_status(); } },
	self_run: { args: { action: 'action', purge: 'purge' }, call: function(request) { return self_run(request.args?.action, request.args?.purge); } },

	pkg_installed: { call: function(request) { return { packages: pkg_installed() }; } },
	pkg_upgradable: { call: function(request) { return { packages: pkg_upgradable() }; } },
	pkg_search: { args: { q: 'q' }, call: function(request) { return pkg_search(request.args?.q); } },
	pkg_plan: { args: { action: 'action', pkgs: 'pkgs' }, call: function(request) { return pkg_plan(request.args?.action, request.args?.pkgs); } },
	pkg_status: { call: function(request) { return pkg_status(); } },
	log_clear: { call: function(request) { return log_clear(); } },
	pkg_run: { args: { action: 'action', pkgs: 'pkgs' }, call: function(request) { return pkg_run(request.args?.action, request.args?.pkgs); } },

	clients: {
		args: { range: 'range' },
		call: function(request) { return clients(request.args?.range); }
	},

	client: {
		args: { mac: 'mac', range: 'range' },
		call: function(request) { return client_series(lc(request.args?.mac ?? ''), request.args?.range); }
	},

	history: {
		args: { range: 'range' },
		call: function(request) { return history(request.args?.range); }
	},

	stats: {
		call: function(request) {
			let la = split(trim(readfile('/proc/loadavg') ?? ''), ' ');
			// /proc/loadavg totals can be host-wide in containers; count our own pid namespace instead
			let nproc = length(filter(lsdir('/proc') ?? [], (d) => match(d, /^[0-9]+$/)));
			return {
				mem: read_meminfo(),
				cpu: read_cpu(),
				temps: read_temps(),
				conntrack: { count: int_file('/proc/sys/net/netfilter/nf_conntrack_count'), max: int_file('/proc/sys/net/netfilter/nf_conntrack_max') },
				procs: nproc,
				load: [+la[0], +la[1], +la[2]],
			};
		}
	},
	routes: { call: function(request) { return read_routes(); } },
	topology: {
		call: function(request) {
			let bridges = read_bridges(), fdb = {};
			for (let br in keys(bridges)) fdb[br] = read_fdb(br);
			return { bridges, fdb, neigh: read_arp() };
		}
	},
};

return { lumen: methods };
