{
	"lumen": {
		"description": "Lumen panel: topology data and safe-apply of UCI changes",
		"read": {
			"ubus": { "lumen": [ "topology", "stats", "history", "clients", "client", "pkg_installed", "pkg_upgradable", "pkg_search", "pkg_plan", "pkg_status", "version", "self_status" ], "uci": [ "configs" ], "iwinfo": [ "phyname", "freqlist", "countrylist", "txpowerlist" ] },
			"uci": [ "lumen" ]
		},
		"write": {
			"ubus": { "uci": [ "revert", "rollback", "changes" ], "lumen": [ "pkg_run", "self_run" ] },
			"uci": [ "lumen" ]
		}
	}
}
