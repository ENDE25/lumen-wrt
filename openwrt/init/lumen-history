#!/bin/sh /etc/rc.common
# Lumen traffic history + per-client accounting collector

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/libexec/lumen/history.uc
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

# remove our nftables table so nothing keeps counting once the collector is gone
stop_service() {
	nft delete table inet lumen 2>/dev/null
}
